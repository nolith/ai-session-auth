{
  "session_hours": 24,
  "github": {
    "enabled": true,
    "client_id": "Iv23_REPLACE_WITH_YOUR_APP_CLIENT_ID",
    "expected_user": "YOUR_GITHUB_USERNAME",
    "state_file": "~/.local/state/ai-session-auth/github.json",
    "repositories": ["YOUR_GITHUB_USERNAME/YOUR_REPOSITORY"]
  },
  "gitlab": {
    "enabled": true,
    "expected_user": "YOUR_GITLAB_USERNAME",
